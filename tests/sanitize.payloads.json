[
  {"name": "script tag", "input": "<script>alert(1)</script>hi", "mustNotContain": ["<script", "alert(1)"]},
  {"name": "script with case/space tricks", "input": "<ScRiPt >alert(1)</sCrIpT >", "mustNotContain": ["<script", "alert(1)"]},
  {"name": "img onerror", "input": "<img src=x onerror=alert(1)>", "mustNotContain": ["<img", "onerror", "src="]},
  {"name": "svg onload", "input": "<svg onload=alert(1)><circle/></svg>", "mustNotContain": ["<svg", "onload", "alert(1)"]},
  {"name": "svg animate onbegin", "input": "<svg><animate onbegin=alert(1) attributeName=x dur=1s>", "mustNotContain": ["<svg", "<animate", "onbegin"]},
  {"name": "math/xlink", "input": "<math><mi xlink:href=\"javascript:alert(1)\">x</mi></math>", "mustNotContain": ["<math", "javascript:"]},
  {"name": "javascript href", "input": "<a href=\"javascript:alert(1)\">x</a>", "mustNotContain": ["javascript:", "href=\"javascript"]},
  {"name": "mixed-case javascript href", "input": "<a href=\"JaVaScRiPt:alert(1)\">x</a>", "mustNotContain": ["javascript:"]},
  {"name": "tab-obfuscated scheme", "input": "<a href=\"java&#x09;script:alert(1)\">x</a>", "mustNotContain": ["javascript:", "java\tscript", "script:alert"]},
  {"name": "newline-obfuscated scheme", "input": "<a href=\"java&#10;script:alert(1)\">x</a>", "mustNotContain": ["script:alert"]},
  {"name": "leading whitespace/control scheme", "input": "<a href=\"&#x01; javascript:alert(1)\">x</a>", "mustNotContain": ["javascript:"]},
  {"name": "entity-encoded colon", "input": "<a href=\"javascript&colon;alert(1)\">x</a>", "mustNotContain": ["javascript", "alert(1)\""]},
  {"name": "numeric-entity scheme", "input": "<a href=\"&#106;&#97;&#118;&#97;&#115;&#99;&#114;&#105;&#112;&#116;&#58;alert(1)\">x</a>", "mustNotContain": ["javascript:", "&#106;"]},
  {"name": "data html href", "input": "<a href=\"data:text/html,<script>alert(1)</script>\">x</a>", "mustNotContain": ["data:", "<script"]},
  {"name": "data base64 href", "input": "<a href=\"data:text/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg==\">x</a>", "mustNotContain": ["data:"]},
  {"name": "vbscript href", "input": "<a href=\"vbscript:msgbox(1)\">x</a>", "mustNotContain": ["vbscript:"]},
  {"name": "protocol-relative / relative href", "input": "<a href=\"//evil.example/x\">x</a><a href=\"/rel\">y</a>", "mustNotContain": ["href=\"//", "href=\"/rel"]},
  {"name": "file: href", "input": "<a href=\"file:///etc/passwd\">x</a>", "mustNotContain": ["file:"]},
  {"name": "href attribute breakout", "input": "<a href=\"https://example.com/\" onmouseover=\"alert(1)\">x</a>", "mustNotContain": ["onmouseover", "alert(1)"]},
  {"name": "quote breakout in href", "input": "<a href='https://example.com/\" onfocus=\"alert(1)\" x=\"'>x</a>", "mustNotContain": ["onfocus=\"", "\" onfocus"]},
  {"name": "style attribute", "input": "<p style=\"background:url(javascript:alert(1))\">x</p>", "mustNotContain": ["style", "javascript:"]},
  {"name": "style tag", "input": "<style>@import 'https://evil.example/x.css';</style>x", "mustNotContain": ["<style", "@import"]},
  {"name": "srcset/picture", "input": "<picture><source srcset=\"x\" onerror=alert(1)><img srcset=\"x 1x\" onerror=alert(1)></picture>", "mustNotContain": ["srcset", "<img", "<source", "onerror"]},
  {"name": "formaction button", "input": "<form action=\"https://evil.example\"><button formaction=\"javascript:alert(1)\">x</button></form>", "mustNotContain": ["<form", "<button", "formaction", "javascript:"]},
  {"name": "iframe srcdoc", "input": "<iframe srcdoc=\"<script>alert(1)</script>\"></iframe>", "mustNotContain": ["<iframe", "srcdoc", "<script"]},
  {"name": "object/embed", "input": "<object data=\"javascript:alert(1)\"></object><embed src=\"javascript:alert(1)\">", "mustNotContain": ["<object", "<embed", "javascript:"]},
  {"name": "base tag", "input": "<base href=\"https://evil.example/\"><a href=\"x\">y</a>", "mustNotContain": ["<base", "evil.example"]},
  {"name": "meta refresh", "input": "<meta http-equiv=\"refresh\" content=\"0;url=javascript:alert(1)\">", "mustNotContain": ["<meta", "refresh"]},
  {"name": "link stylesheet", "input": "<link rel=stylesheet href=\"https://evil.example/x.css\">", "mustNotContain": ["<link", "evil.example"]},
  {"name": "comment with conditional", "input": "<!--[if IE]><script>alert(1)</script><![endif]--><p>ok", "mustNotContain": ["<!--", "<script", "alert(1)"]},
  {"name": "unclosed tag at end", "input": "<p>hello <a href=\"https://example.com\" onclick=\"alert(1)", "mustNotContain": ["onclick", "alert(1)"]},
  {"name": "unclosed script", "input": "<p>x<script>alert(1)", "mustNotContain": ["<script", "alert(1)"]},
  {"name": "div-closing breakout", "input": "</div></body></html><script>alert(1)</script>", "mustNotContain": ["<script", "alert(1)"]},
  {"name": "nested anchors", "input": "<a href=\"https://a.example\"><a href=\"javascript:alert(1)\">x</a></a>", "mustNotContain": ["javascript:", "<a href=\"https://a.example/\" rel=\"nofollow noopener noreferrer\" target=\"_blank\"><a"]},
  {"name": "noscript mXSS", "input": "<noscript><p title=\"</noscript><img src=x onerror=alert(1)>\"></noscript>", "mustNotContain": ["<img", "onerror", "<noscript"]},
  {"name": "svg+style mXSS", "input": "<svg></p><style><a id=\"</style><img src=1 onerror=alert(1)>\">", "mustNotContain": ["<img", "onerror", "<style", "<svg"]},
  {"name": "math+mglyph mXSS", "input": "<math><mtext><table><mglyph><style><!--</style><img title=\"--&gt;&lt;img src=1 onerror=alert(1)&gt;\">", "mustNotContain": ["<img", "onerror", "<style", "<math"]},
  {"name": "template contents", "input": "<template><script>alert(1)</script><img src=x onerror=alert(1)></template>", "mustNotContain": ["<template", "<script", "onerror"]},
  {"name": "textarea/title raw-text breakout", "input": "<textarea></textarea><img src=x onerror=alert(1)>", "mustNotContain": ["<textarea", "<img", "onerror"]},
  {"name": "xmp/plaintext", "input": "<xmp><img src=x onerror=alert(1)></xmp><plaintext><script>alert(1)</script>", "mustNotContain": ["<xmp", "<plaintext", "<img", "<script", "onerror"]},
  {"name": "nested pre/code abuse", "input": "<pre><code><pre><code><script>alert(1)</script><img src=x onerror=alert(1)></code></pre></code></pre>", "mustNotContain": ["<script", "<img", "onerror"]},
  {"name": "attributes on allowed tags", "input": "<p onclick=\"alert(1)\" class=\"x\" id=\"y\"><i onmouseover=alert(1)>a</i><code style=\"x\">b</code></p>", "mustNotContain": ["onclick", "onmouseover", "class=", "id=", "style="]},
